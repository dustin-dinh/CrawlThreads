# Copy this file to .env. Never commit real secrets.
ENVIRONMENT=production
DATABASE_URL=sqlite:///C:/absolute/path/to/CrawlThread/data/story_miner.db

# Meta Threads API — requires threads_basic + threads_keyword_search.
THREADS_ACCESS_TOKEN=
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_API_BASE=https://graph.threads.net/v1.0

# Reddit OAuth application credentials.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=windows:story-miner:1.0 (local research tool; contact: your-name)

# Optional OpenAI-compatible or local Ollama analysis.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

DUPLICATE_SIMILARITY_THRESHOLD=0.88
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3

